# nginx site for the Hamlet game server (TLS lines are added by certbot --nginx).
server {
    listen 80;
    listen [::]:80;
    server_name hamlet.codex074.com;

    client_max_body_size 10m;          # village saves can be a few MB
    gzip on;
    gzip_proxied any;
    gzip_types application/json text/javascript text/css;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
